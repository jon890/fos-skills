#!/usr/bin/env node
// git 이 부르는 commit-msg 훅 진입이다. 동작과 종료 코드는 commit-msg.ts 머리 주석이 소유한다.
// 확장자가 없어 node 가 CommonJS 로 읽고 타입 문법을 지우지 않는다. 그래서 타입 문법 없이 import() 로 본체를 부른다.
// .git/hooks 의 링크로 불려도 원본 옆의 본체를 찾도록 실제 경로 기준으로 고른다.
'use strict'
const { realpathSync } = require('node:fs')
const { pathToFileURL } = require('node:url')

import(pathToFileURL(realpathSync(__filename) + '.ts').href).then(
  (hook) => {
    process.exitCode = hook.main(process.argv.slice(2))
  },
  (err) => {
    process.stderr.write('commit-msg 훅을 읽지 못했다: ' + (err && err.message ? err.message : String(err)) + '\n')
    process.exitCode = 126
  },
)
