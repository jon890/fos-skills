{
  "description": "orch: check --wait 를 셸의 & 나 nohup 으로 띄우는 호출, cd 뒤 ; 나 줄바꿈으로 이은 git 쓰기, worker 터미널 직접 orca terminal send, spec-line 이 아닌 worker-start --spec 을 거부한다",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/orch/hooks/block-background-wait.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/orch/hooks/block-git-after-cd.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/orch/hooks/block-worker-terminal-send.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/orch/hooks/require-spec-line.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
