#!/usr/bin/env -S node --disable-warning=ExperimentalWarning
// 이벤트 핸들러의 PATH 맨 앞에 두는 orca shim 이다. 거부 규칙과 종료 코드는 guard.ts 머리 주석이 소유한다.
// 확장자가 없어 node 는 타입 문법을 지우지 않는다. 그래서 타입 문법 없이 import() 로 guard.ts 를 부른다.
// 위쪽 package.json 의 type 에 따라 CommonJS 로도 ESM 으로도 읽히므로 require, __dirname 대신
// process.getBuiltinModule 과 process.argv[1] 을 쓴다.
const { realpathSync } = process.getBuiltinModule('node:fs')
const { dirname, join } = process.getBuiltinModule('node:path')
const { pathToFileURL } = process.getBuiltinModule('node:url')

import(pathToFileURL(join(dirname(realpathSync(process.argv[1])), 'guard.ts')).href).then(
  (guard) => {
    process.exitCode = guard.main('orca', process.argv.slice(2))
  },
  (err) => {
    process.stderr.write('orca 가드를 읽지 못했다: ' + (err && err.message ? err.message : String(err)) + '\n')
    process.exitCode = 126
  },
)
