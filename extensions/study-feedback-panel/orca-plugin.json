{
  "manifestVersion": 2,
  "id": "study-feedback-panel",
  "name": "공부·피드백",
  "version": "0.1.0",
  "description": "오늘의 공부 후보와 스킬 피드백을 고르고 진행 중인 일을 확인하는 Orca 패널",
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "study-feedback-panel",
        "title": "공부·피드백",
        "icon": "book",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "settings": [
      {
        "key": "botHome",
        "title": "fosbot 홈",
        "description": "요약 파일과 공부·피드백 대기열이 있는 폴더의 절대 경로",
        "type": "string",
        "default": ""
      },
      {
        "key": "panelAutomationId",
        "title": "공부·피드백 패널 자동화",
        "description": "「공부·피드백 패널 요청」 자동화의 전체 UUID",
        "type": "string",
        "default": ""
      },
      {
        "key": "orcaExecutable",
        "title": "Orca 실행 파일",
        "description": "PATH에서 orca를 찾을 수 없으면 실행 파일의 절대 경로를 넣어요.",
        "type": "string",
        "default": ""
      }
    ]
  },
  "capabilities": [
    {
      "kind": "settings:own"
    },
    {
      "kind": "storage:own"
    }
  ]
}
