{
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2023",
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["orch/scripts/**/*.ts", "orch/hooks/**/*.ts", "work-board/**/*.ts"],
  "exclude": ["work-board/tests"]
}
