{
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2023",
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["skills/orch/scripts/**/*.ts", "skills/orch/hooks/**/*.ts", "extensions/work-board/**/*.ts", "skills/inbox/scripts/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["extensions/work-board/tests"]
}
